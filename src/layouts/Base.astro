---
// Self-hosted fonts (faster than Google Fonts; the browser only downloads
// the files a page actually uses).
import '@fontsource/noto-nastaliq-urdu/400.css';
import '@fontsource/noto-nastaliq-urdu/700.css';
import '@fontsource/noto-naskh-arabic/400.css';
import '@fontsource/noto-naskh-arabic/600.css';
import '@fontsource/noto-naskh-arabic/700.css';
import '@fontsource/amiri/400.css';
import '@fontsource/cormorant-garamond/600.css';
import '@fontsource/cormorant-garamond/700.css';
import '@fontsource/spectral/400.css';
import '@fontsource/spectral/600.css';
import '@fontsource/spectral/700.css';
import '../styles/global.css';

import { SITE, CATEGORIES, type Lang } from '../site';
import { t, href, catLabel } from '../i18n';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** Path of this page in this language, e.g. '/articles/x/' or '/en/articles/x/' */
  path: string;
  /** Path of the same page in the other language, if it exists */
  altPath?: string;
  image?: string;
  type?: 'website' | 'article';
  jsonLd?: object[];
  noindex?: boolean;
  publishedTime?: string;
  modifiedTime?: string;
}

const { lang, title, description, path, altPath, image, type = 'website', jsonLd = [], noindex = false, publishedTime, modifiedTime } = Astro.props;
const other: Lang = lang === 'ur' ? 'en' : 'ur';
const canonical = new URL(path, SITE.url).href;
const altUrl = altPath ? new URL(altPath, SITE.url).href : null;
const ogImage = new URL(image || '/assets/og-cover.png', SITE.url).href;
const urUrl = lang === 'ur' ? canonical : altUrl;
const enUrl = lang === 'en' ? canonical : altUrl;
const switchTo = altPath || href(other, '/');
const home = href(lang, '/');
const socials = Object.entries(SITE.social).filter(([, v]) => v);
const socialNames: Record<string, string> = { facebook: 'Facebook', youtube: 'YouTube', x: 'X (Twitter)', whatsappChannel: 'WhatsApp Channel' };
const year = new Date().getFullYear();
---
<!DOCTYPE html>
<html lang={lang} dir={lang === 'ur' ? 'rtl' : 'ltr'}>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content={description}>
  <meta name="author" content={SITE.author[lang]}>
  <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'}>
  <link rel="canonical" href={canonical}>
  {urUrl && <link rel="alternate" hreflang="ur" href={urUrl}>}
  {enUrl && <link rel="alternate" hreflang="en" href={enUrl}>}
  {urUrl && <link rel="alternate" hreflang="x-default" href={urUrl}>}

  <meta property="og:type" content={type}>
  <meta property="og:site_name" content={t(lang, 'brand')}>
  <meta property="og:locale" content={lang === 'ur' ? 'ur_PK' : 'en_US'}>
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonical}>
  <meta property="og:image" content={ogImage}>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  {publishedTime && <meta property="article:published_time" content={publishedTime}>}
  {modifiedTime && <meta property="article:modified_time" content={modifiedTime}>}
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={ogImage}>

  <meta name="theme-color" content="#0a1628">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="icon" href="/favicon.ico" sizes="32x32">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <link rel="alternate" type="application/rss+xml" title={t(lang, 'brand')} href={href(lang, '/rss.xml')}>
  {jsonLd.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}
</head>
<body class={lang === 'en' ? 'lang-en' : 'lang-ur'}>
  <a href="#main-content" class="visually-hidden">{t(lang, 'skip')}</a>
  <div class="top-bar">{t(lang, 'topbar')}</div>

  <header>
    <div class="header-main">
      <a href={home} class="brand">
        <div class="brand-logo" aria-hidden="true">{t(lang, 'logo')}</div>
        <div class="brand-text">
          <p class="brand-name">{t(lang, 'brand')}</p>
          <p class="tagline">{t(lang, 'tagline')}</p>
        </div>
      </a>
      <div class="nav-right">
        <nav class="primary" aria-label={t(lang, 'menu')}>
          <ul>
            <li><a href={home}>{t(lang, 'nav_home')}</a></li>
            <li><a href={home + '#scripture'}>{t(lang, 'nav_scripture')}</a></li>
            <li><a href={home + '#daily'}>{t(lang, 'nav_daily')}</a></li>
            <li><a href={home + '#articles'}>{t(lang, 'nav_articles')}</a></li>
            <li><a href={href(lang, '/about/')}>{t(lang, 'nav_about')}</a></li>
          </ul>
        </nav>
        <details class="mobile-nav">
          <summary>☰ {t(lang, 'menu')}</summary>
          <ul>
            <li><a href={home}>{t(lang, 'nav_home')}</a></li>
            <li><a href={home + '#scripture'}>{t(lang, 'nav_scripture')}</a></li>
            <li><a href={home + '#daily'}>{t(lang, 'nav_daily')}</a></li>
            <li><a href={home + '#articles'}>{t(lang, 'nav_articles')}</a></li>
            <li><a href={href(lang, '/about/')}>{t(lang, 'nav_about')}</a></li>
          </ul>
        </details>
        <a class="lang-toggle" href={switchTo} hreflang={other} lang={other} aria-label={t(lang, 'other_lang_label')}>{t(lang, 'other_lang')}</a>
      </div>
    </div>
  </header>

  <slot name="top" />
  <main id="main-content">
    <slot />
  </main>

  <footer class="site-footer">
    <div class="footer-container">
      <div class="footer-brand">
        <p class="display footer-title">{t(lang, 'brand')}</p>
        <p>{t(lang, 'footer_brand_p')}</p>
      </div>
      <nav class="footer-col" aria-label={t(lang, 'footer_links')}>
        <h2>{t(lang, 'footer_links')}</h2>
        <ul>
          <li><a href={home}>{t(lang, 'nav_home')}</a></li>
          <li><a href={home + '#daily'}>{t(lang, 'nav_daily')}</a></li>
          <li><a href={home + '#articles'}>{t(lang, 'nav_articles')}</a></li>
          <li><a href={href(lang, '/about/')}>{t(lang, 'nav_about')}</a></li>
          <li><a href={href(lang, '/rss.xml')}>RSS</a></li>
        </ul>
      </nav>
      <nav class="footer-col" aria-label={t(lang, 'footer_cats')}>
        <h2>{t(lang, 'footer_cats')}</h2>
        <ul>
          {CATEGORIES.map((c) => <li><a href={href(lang, `/category/${c}/`)}>{catLabel(lang, c)}</a></li>)}
        </ul>
      </nav>
      <div class="footer-col">
        <h2>{t(lang, 'footer_contact')}</h2>
        <ul>
          <li><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
          {socials.map(([k, v]) => <li><a href={v} rel="me noopener" target="_blank">{socialNames[k] ?? k}</a></li>)}
        </ul>
      </div>
    </div>
    <div class="footer-bottom"><p>© {year} {t(lang, 'brand')}{lang === 'ur' ? '۔' : '.'} {t(lang, 'footer_bottom')}</p></div>
  </footer>
</body>
</html>
